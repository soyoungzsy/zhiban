# ============================================================
# server/.env.example — 植伴服务端代理凭证占位（v4 第二批）
#
# 使用：复制本文件为 server/.env，填入真实凭证后启动：
#     cp server/.env.example server/.env
#     node server/server.js
#
# 规则（必须遵守）：
#   · server/.env 永远不要提交到版本库、不要打进审核包、不要发给别人
#   · 浏览器端代码永远不出现这些值；所有第三方调用都走本代理
#   · 凭证不要在聊天中明文发送；缺哪项，对应功能在 /api/health 里如实报告"待配置"
#   · 不要为验证功能擅自开通付费服务；先用演示模式（MOCK_VISION=1）跑流程
# ============================================================

# ---- 视觉识别：智谱 GLM-4.6V（docs.bigmodel.cn）----
# 获取路径：open.bigmodel.cn 控制台 → API Keys。模型按账户实际可用为准。
ZHIPU_API_KEY=
GLM_MODEL=glm-4.6v

# ---- 真实天气：和风天气（dev.qweather.com）----
# 获取路径：和风开发者控制台。API Host 在控制台"设置"里查看——不要照搬旧博客的固定域名。
QWEATHER_API_HOST=
# 认证：和风支持 API KEY 与 JWT 两种；本代理默认用 API KEY（服务端持有，浏览器不可见）。
# 若控制台仅开放 JWT，在 server/lib.mjs 的 qweatherJwt() 处按官方指引补全（须真凭证联调后启用）。
QWEATHER_KEY=

# ---- 代理本身 ----
PORT=8438

# ---- 演示模式（流程验证用，不是真实识别）----
# MOCK_VISION=1 时 /api/vision/detect 返回固定的示例检测；
# /api/health 会如实报告 vision.mode="mock"，前端页面会明示"演示模式（非真实识别）"。
MOCK_VISION=